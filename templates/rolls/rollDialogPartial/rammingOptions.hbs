<!-- MODIFIED DAMAGE -->
<li class="SR-LigneEnTete SR-PaddingTop10 grid SR-TextUppercase">
	<div class="col-11">{{localize 'SR5.ModifiedDamage'}}</div>
  	<div class="col-1 SR-TextCenter">
		<input disabled type="number" name="modifiedDamage" value="{{damage.value}}" placeholder="0" data-dtype="Number" />
  	</div>
</li>

<!-- ANGLE OF IMPACT -->
<li class="grid">
    <div class="col-6" title="{{localize 'SR5.RammingAngleHint'}}">{{localize 'SR5.RammingAngle'}}{{localize 'SR5.Colons'}}</div>
    <div class="col-5 SR-TextRight">
        <select class="SR-RammingInput" name="rammingAngle">
            {{selectOptions lists.rammingAngles selected=combat.ramming.angle localize=true sort=false}}
        </select>
    </div>
</li>
<!-- CURRENT SPEEDS -->
<li class="grid">
    <div class="col-10">{{localize 'SR5.RammingAttackerSpeed'}}{{localize 'SR5.Colons'}}</div>
    <div class="col-1 SR-TextCenter">
        <input class="SR-RammingInput" type="number" min="0" name="rammingAttackerSpeed" value="{{combat.ramming.attackerSpeed}}" data-dtype="Number" />
    </div>
</li>
<li class="grid">
    <div class="col-10">{{localize 'SR5.RammingTargetSpeed'}}{{localize 'SR5.Colons'}}</div>
    <div class="col-1 SR-TextCenter">
        <input class="SR-RammingInput" type="number" min="0" name="rammingTargetSpeed" value="{{combat.ramming.targetSpeed}}" data-dtype="Number" />
    </div>
</li>
