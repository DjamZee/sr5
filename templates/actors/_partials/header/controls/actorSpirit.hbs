{{!-- Spirit type and Force, then the bound switch --}}
<div class="SR-EspritType">
  <p class="SRTextInBox">{{findTranslation 'spiritTypes' system.type}}</p>
</div>
<div class="SRemptyBox" title="{{localize 'SR5.Force'}}">
  <input class="SRinputInBox" type="number" data-dtype="Number" name="system.force.base" value="{{system.force.base}}">
</div>
{{!-- Homunculus material: its Structure is the Body (SR5 p. 301, table SR5 p. 198) --}}
{{#if isHomunculus}}
<div class="SR-EspritType" title="{{localize 'SR5.HomunculusMaterial'}}">
  <select name="system.homunculusMaterial.type" data-dtype="String">
    <option class="SR-LightGreyColor" value="">{{localize 'SR5.HomunculusMaterialNone'}}</option>
    {{selectOptions homunculusMaterials selected=system.homunculusMaterial.type}}
  </select>
</div>
{{#ife system.homunculusMaterial.type 'other'}}
<div class="SRemptyBox" title="{{localize 'SR5.Structure'}}">
  <input class="SRinputInBox" type="number" min="0" data-dtype="Number" name="system.homunculusMaterial.structure" value="{{system.homunculusMaterial.structure}}">
</div>
<div class="SRemptyBox" title="{{localize 'SR5.VehicleStat_ArmorShort'}}">
  <input class="SRinputInBox" type="number" min="0" data-dtype="Number" name="system.homunculusMaterial.armor" value="{{system.homunculusMaterial.armor}}">
</div>
{{/ife}}
{{/if}}
<div class="SR-Materialize"
  data-helpTitle="{{localize 'SR5.HELP_BoundedButton'}}"
  data-helpMessage="{{localize 'SR5.HELP_BoundedButtonMsg'}}"
  >
  <input id="boundedIcon" type="checkbox" name="system.isBounded" data-dtype="Boolean" {{checked system.isBounded}}>
  <label for="boundedIcon"{{#if system.isBounded}} class="active"{{/if}}>{{> systems/sr5/assets/img/icons/nav-link.svg}}</label>
</div>
{{!-- Forbidden Arcana p. 172-175: Elemental, wild, Domain. The gamemaster's only --}}
{{#if system.isGM}}
<div class="SR-EspritType" title="{{localize 'SR5.SpiritTraits'}}">
  <label data-tooltip="{{localize 'SR5.SpiritElemental_D'}}"><input type="checkbox" class="sr5-spirit-ledger" data-trait="isElemental" {{checked system.isElemental}}> {{localize 'SR5.SpiritElemental'}}</label>
  <label data-tooltip="{{localize 'SR5.SpiritWild_D'}}"><input type="checkbox" class="sr5-spirit-ledger" data-trait="isWild" {{checked system.isWild}}> {{localize 'SR5.SpiritWild'}}</label>
  <label data-tooltip="{{localize 'SR5.SpiritDomain_D'}}"><input type="checkbox" class="sr5-spirit-ledger" data-trait="hasDomain" {{checked system.hasDomain}}> {{localize 'SR5.SpiritDomain'}}</label>
  <label data-tooltip="{{localize 'SR5.SpiritMagicPact_D'}}"><input type="checkbox" class="sr5-spirit-ledger" data-trait="magicPact" {{checked system.magicPact}}> {{localize 'SR5.SpiritMagicPact'}}</label>
  <label data-tooltip="{{localize 'SR5.SpiritFree_D'}}"><input type="checkbox" class="sr5-spirit-ledger" data-trait="isFree" {{checked system.isFree}}> {{localize 'SR5.SpiritFree'}}</label>
  {{#if system.isFree}}
  <label data-tooltip="{{localize 'SR5.SpiritFreeEdge_D'}}">{{localize 'SR5.Edge'}} <input type="number" min="0" class="SRinputInBox sr5-spirit-ledger" data-trait="freeEdge" value="{{system.freeEdge}}" placeholder="{{system.specialAttributes.edge.natural.value}}"></label>
  {{/if}}
</div>
{{/if}}
{{!-- Materialization switch: from the astral initiative to the physical one, and back (SR5 p. 401) --}}
{{#ifne spiritBaseType 'watcher'}}
<div class="SR-Materialize"
  title="{{localize 'SR5.Materializing'}}"
  data-helpTitle="{{localize 'SR5.HELP_MaterializingButton'}}"
  data-helpMessage="{{localize 'SR5.HELP_MaterializingButtonMsg'}}"
  >
  <input class="init-switch" id="materializeIcon" type="checkbox" name="system.isMaterializing" data-dtype="Boolean" data-binding="{{#if system.isMaterializing}}astralInit{{else}}physicalInit{{/if}}" {{checked system.isMaterializing}} {{#if isHomunculus}}disabled{{/if}}>
  <label for="materializeIcon"{{#if system.isMaterializing}} class="active"{{/if}}>{{> systems/sr5/assets/img/icons/nav-materialize.svg}}</label>
</div>
{{/ifne}}
